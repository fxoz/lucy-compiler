{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lucy",
  "scopeName": "source.lucy",
  "patterns": [{ "include": "#comments" }, { "include": "#strings" }, { "include": "#code" }],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.lucy",
      "begin": "#",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.lucy" } },
      "end": "$"
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lucy",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [{ "include": "#escapes" }, { "include": "#interpolation" }]
        },
        {
          "name": "string.quoted.single.lucy",
          "begin": "'",
          "end": "'|$",
          "patterns": [{ "include": "#escapes" }, { "include": "#interpolation" }]
        }
      ]
    },
    "escapes": { "name": "constant.character.escape.lucy", "match": "\\\\." },
    "interpolation": {
      "name": "meta.interpolation.lucy",
      "contentName": "source.lucy",
      "begin": "\\{",
      "end": "\\}|(?=$)",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.lucy" } },
      "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.lucy" } },
      "patterns": [{ "include": "#strings" }, { "include": "#code" }]
    },
    "code": {
      "patterns": [
        {
          "match": "\\b(fun)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "storage.type.function.lucy" }, "2": { "name": "entity.name.function.lucy" } }
        },
        { "name": "storage.type.lucy", "match": "\\b(?:int|float|str|bool|any|void)\\b" },
        { "name": "keyword.control.lucy", "match": "\\b(?:if|elif|else|while|for|in|break|continue|return)\\b|=>" },
        { "name": "constant.language.lucy", "match": "\\b(?:true|false|True|False|none|None|null)\\b" },
        { "name": "keyword.operator.logical.lucy", "match": "\\b(?:and|or|not)\\b" },
        { "name": "support.function.builtin.lucy", "match": "\\b(?:print|exit)(?=\\s*\\()" },
        { "name": "entity.name.function.lucy", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()" },
        { "name": "constant.numeric.lucy", "match": "(?<![\\w.])(?:0[xX][0-9a-fA-F]+|0[bB][01]+|(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?)(?!\\w)" },
        { "name": "keyword.operator.lucy", "match": "->|==|!=|<=|>=|\\*\\*|[+*/%=<>!&|^-]" },
        { "name": "punctuation.section.brackets.lucy", "match": "[\\[\\](){}]" },
        { "name": "punctuation.separator.lucy", "match": "[,.:]" }
      ]
    }
  }
}
